<Project Sdk="Godot.NET.Sdk/4.7.1">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <IsTrimmable>true</IsTrimmable>
        <VerifyReferenceTrimCompatibility>true</VerifyReferenceTrimCompatibility>
        <!-- Compiles the TwoDogWebBoot.cs bootstrap used by web (browser-wasm)
             hosts; harmless on desktop. It takes a function pointer to the
             source-generated plugins initializer, hence unsafe. -->
        <DefineConstants>$(DefineConstants);LIBGODOT_ENABLED</DefineConstants>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Nested 2dog host projects: keep them out of this project's default
             compile/content globs (each also carries a .gdignore so the Godot
             editor skips them). -->
        <DefaultItemExcludes>$(DefaultItemExcludes);Jomolith.2dog/**;Jomolith.web/**;Jomolith.tests/**</DefaultItemExcludes>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
      <PackageReference Include="Chickensoft.AutoInject" Version="2.13.30" />
      <PackageReference Include="Chickensoft.GodotNodeInterfaces" Version="3.0.30" />
      <PackageReference Include="Chickensoft.Introspection" Version="3.0.3" />
      <PackageReference Include="Chickensoft.Introspection.Generator" Version="3.0.3" />
      <PackageReference Include="Chickensoft.LogicBlocks" Version="6.2.0" />
      <PackageReference Include="RobloxFileFormat" Version="1.0.0" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="src\Towers\Factory\ClientObjects\" />
    </ItemGroup>
</Project>
